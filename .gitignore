/target
**/*.rs.bk

# Sandbox marker, not part of the project.
.ai-jail

# Claude Code local scratch state.
.claude/

# Local secrets — never commit
.env
.env.local
.env.*
*.credentials.json
credentials.json
secrets.json
service_account*.json
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
/config.toml

# Local agent plans and diagnostics can contain machine/account details.
/plans/
/.polyhive/
/.codex/
*.log

# Per-vendor config scratch files (config.<vendor>.toml) — never commit.
# Only config.example.toml is intended for version control.
config.*.toml
!config.example.toml

# Snapshot review files from `cargo insta`
*.snap.new

# Local screenshots for PR bodies (not tracked; drag into the PR on GitHub)
macos/printscreen/
